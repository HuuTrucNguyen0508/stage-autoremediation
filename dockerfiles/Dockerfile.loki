FROM grafana/loki:2.9.2

# Switch to root to set permissions
USER root

# Copy the loki configuration
COPY loki-config.yml /etc/loki/loki-custom-config.yaml

# Set correct permissions for the config file
RUN chown 10001:10001 /etc/loki/loki-custom-config.yaml && \
  chmod 644 /etc/loki/loki-custom-config.yaml

# Create data directory with permissions for UID 1000 (Ubuntu user)
RUN mkdir -p /loki && \
  chown -R 1000:1000 /loki && \
  chmod -R 755 /loki

# Create additional required directories
RUN mkdir -p /loki/rules && \
  chown -R 1000:1000 /loki/rules && \
  chmod -R 755 /loki/rules

# Switch back to loki user
USER 10001

# Expose port 3100
EXPOSE 3100

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3100/ready || exit 1 