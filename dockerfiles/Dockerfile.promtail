FROM grafana/promtail:2.9.2

# Switch to root to set permissions
USER root

# Copy the promtail configuration
COPY promtail-config.yml /etc/promtail/promtail-custom-config.yml

# Set correct permissions for the config file
RUN chown 10001:10001 /etc/promtail/promtail-custom-config.yml && \
    chmod 644 /etc/promtail/promtail-custom-config.yml

# Create and set permissions for the positions directory
RUN mkdir -p /var/lib/promtail && \
    chown 10001:10001 /var/lib/promtail && \
    chmod 755 /var/lib/promtail

# Create data directory with permissions for UID 1000 (Ubuntu user)
RUN mkdir -p /tmp && \
    chown -R 1000:1000 /tmp && \
    chmod -R 755 /tmp

# Switch back to promtail user
USER 10001

# Expose port 9080
EXPOSE 9080 